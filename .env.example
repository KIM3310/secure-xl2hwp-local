APP_NAME=secure-xl2hwp-local
APP_ENV=dev
LOG_LEVEL=INFO
RUNTIME_OWNER=developer
RUNTIME_WORKERS=1
AUTH_RATE_LIMIT_MODE=process-local
AUDIT_STORAGE_MODE=ephemeral
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_PRIMARY_MODEL=qwen2.5:7b
LLM_FALLBACK_MODEL=qwen2.5:14b
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-thinking
OPENROUTER_FALLBACK_MODEL=openai/gpt-5.4-mini
OPENROUTER_HTTP_REFERER=https://secure-xl2hwp-local.pages.dev
OPENROUTER_APP_TITLE=secure-xl2hwp-local
LLM_TIMEOUT_SECONDS=45
LLM_UNAVAILABLE_COOLDOWN_SECONDS=20
ENABLE_LLM=true
AUTH_ENABLED=true
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=120
AUTH_PASSWORD_PEPPER=
USER_REGISTRY_NAME=users
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_SECONDS=120
PROCESS_ALLOWED_ROLES=Admin,Analyst
MAX_UPLOAD_MB=50
ALLOWED_INPUT_BASE_DIR=examples/input
ALLOWED_OUTPUT_BASE_DIR=examples/output
ALLOWED_TEMPLATE_BASE_DIR=examples/input
AUDIT_LOG_DIR=logs/audit
EXPORT_SIGNING_ENABLED=true
EXPORT_SIGNING_KEY_ID=local-hmac-v1
EXPORT_SIGNING_KEY=
