APP_NAME=secure-xl2hwp-local
APP_ENV=dev
LOG_LEVEL=INFO
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_PRIMARY_MODEL=qwen2.5:7b
LLM_FALLBACK_MODEL=qwen2.5:14b
LLM_TIMEOUT_SECONDS=45
LLM_UNAVAILABLE_COOLDOWN_SECONDS=20
ENABLE_LLM=true
AUTH_ENABLED=true
JWT_SECRET_KEY=__REPLACE_WITH_STRONG_SECRET_MIN_32__
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=120
AUTH_PASSWORD_PEPPER=__REPLACE_WITH_STRONG_PEPPER__
USER_REGISTRY_NAME=users
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_SECONDS=120
PROCESS_ALLOWED_ROLES=Admin,Analyst
MAX_UPLOAD_MB=50
ALLOWED_INPUT_BASE_DIR=examples/input
ALLOWED_OUTPUT_BASE_DIR=examples/output
ALLOWED_TEMPLATE_BASE_DIR=examples/input
AUDIT_LOG_DIR=logs/audit
EXPORT_SIGNING_ENABLED=true
EXPORT_SIGNING_KEY_ID=local-hmac-v1
EXPORT_SIGNING_KEY=__REPLACE_WITH_STRONG_SECRET_MIN_32__
